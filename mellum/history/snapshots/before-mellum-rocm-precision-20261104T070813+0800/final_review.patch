+"""Independently recompute generation counts, input identity and frozen hashes."""
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+root = Path(sys.argv[1])
+state = json.loads((root/'validation.json').read_text())
+control = json.loads((root/'control.json').read_text())
+selection = json.loads((root/'selection.json').read_text())
+source = Path(selection['source'])
+assert hashlib.sha256(source.read_bytes()).hexdigest() == selection['source_sha256']
+reference = {r['id']: r for r in json.loads(source.read_text())['results']}
+chosen = [r['id'] for r in selection['samples']]
+assert state['status'] == control['status'] == 'complete'
+assert state['selected_ids'] == chosen and len(set(chosen)) == 10
+assert 'HumanEval/61' not in chosen
+summary = {}
+for name, entry in state['profiles'].items():
+    assert len(entry['samples']) == 11
+    assert {r['id'] for r in entry['samples']} == set(chosen + ['HumanEval/61'])
+    for row in entry['samples'] + entry['repeats']:
+        target = reference[row['id']]
+        assert row['input_ids'] == target['input_ids']
+        assert row['input_sha256'] == target['input_sha256']
+        assert row['reference_ids'] == target['reference_ids']
+        assert len(row['output_ids']) == 64
+        assert row['matching_tokens'] == sum(a == b for a,b in zip(row['output_ids'],target['reference_ids']))
+        assert row['exact'] == (row['output_ids'] == target['reference_ids'])
+    quick = [r for r in entry['samples'] if r['id'] in chosen]
+    matches = sum(r['matching_tokens'] for r in quick)
+    exact = sum(r['exact'] for r in quick)
+    assert matches == entry['matching_tokens'] and exact == entry['exact_sequences']
+    primary = next(r for r in entry['samples'] if r['id'] == 'HumanEval/61')
+    if name == 'correctness':
+        assert len(entry['repeats']) == 11
+        for row in entry['repeats']:
+            first = next(r for r in entry['samples'] if r['id'] == row['id'])
+            assert row['equals_first'] == (row['output_ids'] == first['output_ids'])
+        assert entry['stable_sequences'] == sum(r['equals_first'] for r in entry['repeats'] if r['id'] in chosen)
+    summary[name] = dict(matching_tokens=matches,total_tokens=640,token_match_rate=matches/640,
+        exact_sequences=exact,stable_sequences=entry['stable_sequences'],humaneval61=primary['matching_tokens'])
+hashes = json.loads((root/'source_sha256.json').read_text())
+def frozen_path(name):
+    archived = root/'source_snapshot'/name.lstrip('/')
+    return archived if archived.exists() else Path(name)
+assert all(hashlib.sha256(frozen_path(name).read_bytes()).hexdigest() == value for name,value in hashes.items())
+weights = json.loads((root/'native_torch_weights.json').read_text())
+assert weights['all_equal'] and weights['checkpoint_tensors'] == 5631 and weights['target_parameters'] == 255
+assert not weights['unmapped_sources'] and not weights['unverified_parameters']
+assert control['bf16_full200_status'] == 'stopped_by_user'
+result = dict(passed=True,profiles=summary,frozen_files=len(hashes),source_unchanged=True,
+    source_check='archived snapshot when available; control also records live freeze at completion',
+    checkpoint_tensors=5631,parameters=255,scope='fixed ten plus separate H61; not full200/pass@1/16k')
+(root/'independent_review.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps(result,indent=2))
